# ==========================================================
# Grow More and Stable Life - Production Environment Template
# Duplicate this file to .env and configure secret credentials
# ==========================================================

# Application Core Settings
APP_NAME="Grow More and Stable Life"
ENVIRONMENT="production"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Security & Cryptography
# Generate a secure 64-character secret using: openssl rand -hex 32
SECRET_KEY="generate-your-high-entropy-64-character-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 Days

# Database Configuration (Defaults to SQLite; supports PostgreSQL)
# For SQLite (default persistent location):
DATABASE_URL="sqlite+aiosqlite:///./data/growmore.db"
# For Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://growmore_user:your_password@localhost:5432/growmore_db"

# Redis Distributed Caching (Optional; in-memory fallback included)
REDIS_ENABLED=true
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Upstream Data Provider Base URLs
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"
EXCHANGERATE_BASE_URL="https://open.er-api.com/v6"
PSX_DPS_BASE_URL="https://dps.psx.com.pk"
YAHOO_FINANCE_BASE_URL="https://query1.finance.yahoo.com/v8/finance"

# Cache Invalidation TTLs (in seconds)
CACHE_TTL_LIVE_TICKS=60
CACHE_TTL_CRYPTO=120
CACHE_TTL_FOREX=300
CACHE_TTL_COMMODITY=300
CACHE_TTL_BULLION_PKR=300
CACHE_TTL_MUTUAL_FUNDS=3600
CACHE_TTL_ANNOUNCEMENTS=300
CACHE_TTL_MACRO=43200
CACHE_TTL_SENTIMENT=900

# Next.js Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
